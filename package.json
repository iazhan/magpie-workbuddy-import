{
  "name": "magpie-workbuddy-import",
  "version": "0.2.0",
  "description": "Paste a WorkBuddy credential into magpie: a fourth sign-in method for the workbuddy provider, with the browser, desktop and API-key ones kept.",
  "type": "module",
  "main": "./plugin/index.mjs",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "workbuddy",
    "codebuddy",
    "credential",
    "import"
  ],
  "dependencies": {
    "@magpie-community/opencode-workbuddy-auth": "^0.2.20"
  },
  "files": [
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iazhan/magpie-workbuddy-import.git"
  },
  "homepage": "https://github.com/iazhan/magpie-workbuddy-import#readme",
  "bugs": {
    "url": "https://github.com/iazhan/magpie-workbuddy-import/issues"
  },
  "magpie": {
    "name": "WorkBuddy 凭据导入",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Import a WorkBuddy credential you already have: paste JSON, a Cookie, a request header or an API key into the plugin's own window, and it refreshes the token once before saving. The community plugin's browser, desktop and API-key methods stay as they are.",
      "zh": "把已有的 WorkBuddy 凭据导入 magpie：JSON、Cookie、请求头或 API Key 粘进插件自己开的窗口，保存前先真的刷新一次 token。社区插件的浏览器、桌面端、API Key 三种方式原样保留。"
    }
  }
}
